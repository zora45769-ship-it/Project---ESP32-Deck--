    # ---------------- Serial: работник сам переподключается ----------------
    def refresh_ports(self):
        if serial is None:
            self.ser_status.configure(
                text="pyserial" + self.T("cfg_fail", e="")[:0] +
                     " not installed" if self.lang == "en" else
                     "pyserial не установлен",
                text_color=ERR_COLOR)
            return
        items = [(p.device, f"{p.device} — {p.description}")
                 for p in list_ports.comports()]
        self._ports = {name: dev for dev, name in items}
        self.port_cb.configure(values=[name for _, name in items])
        if items:
            self.port_cb.set(items[0][1])

    def _pick_port(self):
        """Выбор порта: сначала прошлый, потом USB-Serial по описанию."""
        try:
            present = [p.device for p in list_ports.comports()]
        except Exception:
            return None
        last = self.cfg.get("last_port", "")
        if last and last in present:
            return last
        try:
            for p in list_ports.comports():
                desc = (p.description or "").lower()
                if any(v in desc for v in SERIAL_VENDORS):
                    return p.device
        except Exception:
            pass
        return None

    def open_port(self, port):
        s = serial.Serial()
        s.port = port
        s.baudrate = 115200
        s.timeout = 0.1
        s.write_timeout = 1.0
        s.dtr = False
        s.rts = False
        s.open()
        # даём CH340 устаканиться и чистим мусор из буферов
        time.sleep(0.25)
        try:
            s.reset_input_buffer()
            s.reset_output_buffer()
        except Exception:
            pass
        return s

    def _serial_worker(self, port):
        """Единственный поток, открывающий и закрывающий порт.
        Сам переподключается после обрывов — до 6 попыток с паузой 2 с.
        Watcher подключается только если этот поток вообще умер."""
        retries = 0
        try:
            while not self._watcher_stop.is_set():
                if self._manual_disconnect:
                    return
                try:
                    ser = self.open_port(port)
                except Exception as ex:
                    retries += 1
                    if retries == 1:
                        self.rx_queue.put(
                            ("serial_retry", f"{port}: {ex}"))
                        _write_crash_log(f"[connect] open fail {port}: {ex}")
                    if retries >= 6:
                        self.rx_queue.put(
                            ("serial_dead",
                             self.T("serial_dead", p=port)))
                        _write_crash_log(f"[connect] give up {port}")
                        return
                    self._watcher_stop.wait(2.0)
                    continue

                self.ser = ser
                retries = 0
                self.running = True
                self.rx_queue.put(("serial_ok", port))
                _write_crash_log(f"[connect] opened {port}")

                buf = b""
                lost = None
                while self.running and not self._manual_disconnect:
                    try:
                        n = ser.in_waiting
                        data = ser.read(n if n else 1)
                    except Exception as ex:
                        lost = f"read fail: {ex}"
                        _write_crash_log(f"[connect] read fail: {ex}")
                        break
                    if not data:
                        continue
                    buf += data
                    while b"\n" in buf:
                        raw, buf = buf.split(b"\n", 1)
                        line = raw.decode("utf-8", "ignore").strip()
                        if not line:
                            continue
                        if line.startswith("TRIG "):
                            self.rx_queue.put(("trig", line[5:].strip()))
                        elif line.startswith("INFO "):
                            self.rx_queue.put(("info", line[5:].strip()))
                        else:
                            self.reply_q.put(line)

                # закрываем порт здесь же, в этом потоке
                try:
                    ser.close()
                except Exception:
                    pass
                if lost and self.running and not self._manual_disconnect:
                    self.running = False
                    self.rx_queue.put(("serial_retry", lost))
                if self._manual_disconnect or self._watcher_stop.is_set():
                    return
                self._watcher_stop.wait(2.0)
        except Exception as ex:
            _write_crash_log("[worker] " + str(ex))
        finally:
            self.running = False

    def serial_connect(self, port, quiet=False):
        self._manual_disconnect = False
        if self.conn_thread and self.conn_thread.is_alive():
            self.running = False
            self.conn_thread.join(timeout=2.0)
        self.ser = None
        self.ser_status.configure(text=self.T("ser_try"),
                                  text_color=IDLE_COLOR)
        self.conn_thread = threading.Thread(
            target=self._serial_worker, args=(port,), daemon=True)
        self.conn_thread.start()
        return True

    def manual_connect(self):
        if self.busy:
            return
        port = self._ports.get(self.port_cb.get(),
                               self.port_cb.get().split(" — ")[0])
        if not port:
            messagebox.showwarning(self.T("err_serial"),
                                   self.T("warn_port"))
            return
        self.serial_connect(port, quiet=False)

    def auto_connect_now(self):
        port = self._pick_port()
        if not port:
            messagebox.showerror(self.T("err_find_t"), self.T("err_find"))
            return
        self.serial_connect(port, quiet=False)

    def _watcher_loop(self):
        """Поднимает связь, только если работник совсем умер."""
        while not self._watcher_stop.wait(3.0):
            if self.running or self.busy or serial is None:
                continue
            if not self.cfg.get("auto_connect", True):
                continue
            if self._manual_disconnect:
                continue
            alive = self.conn_thread is not None and \
                self.conn_thread.is_alive()
            if alive:
                continue
            port = self._pick_port()
            if port:
                self.rx_queue.put(("watch_try", port))

    def serial_disconnect(self):
        self._manual_disconnect = True
        self.running = False
        self.after(200, self._finalize_disconnect)

    def _finalize_disconnect(self):
        t = self.conn_thread
        if t and t.is_alive():
            t.join(timeout=2.0)
        self.ser = None
        self.ser_status.configure(text=self.T("ser_nc"),
                                  text_color=ERR_COLOR)
        self.ser_status2.configure(text="Serial: —", text_color=IDLE_COLOR)
        self.ble_status.configure(text="BLE: —", text_color=IDLE_COLOR)

    def _drain_reply(self):
        try:
            while True:
                self.reply_q.get_nowait()
        except queue.Empty:
            pass

    def request(self, line, stops, timeout=2.0):
        if not self.ser or not self.running:
            return None
        self._drain_reply()
        try:
            with self.io_lock:
                self.ser.write((line + "\n").encode("utf-8"))
        except Exception:
            return None
        lines, deadline = [], time.time() + timeout
        while time.time() < deadline:
            try:
                ln = self.reply_q.get(timeout=0.05)
            except queue.Empty:
                continue
            lines.append(ln)
            if any(ln.startswith(s) for s in stops):
                return lines
        return lines or None

    def poll_rx(self):
        try:
            while True:
                kind, payload = self.rx_queue.get_nowait()
                if kind == "trig":
                    self.on_trigger(payload)
                elif kind == "info":
                    if payload.startswith("ble="):
                        on = payload.split("ble=")[-1].strip() == "1"
                        self.ble_status.configure(
                            text=self.T("ble_on") if on
                            else self.T("ble_wait"),
                            text_color=OK_COLOR if on else IDLE_COLOR)
                elif kind == "serial_ok":
                    port = payload
                    self.cfg["last_port"] = port
                    self.save_config()
                    self.ser_status.configure(
                        text=self.T("ser_ok", p=port),
                        text_color=OK_COLOR)
                    self.ser_status2.configure(text=f"Serial: {port}",
                                               text_color=OK_COLOR)
                    self.log(self.T("log_connected", p=port))
                elif kind == "serial_retry":
                    self.ser_status.configure(text=self.T("ser_retry"),
                                              text_color=IDLE_COLOR)
                    self.log(self.T("log_lost", e=payload))
                elif kind == "serial_dead":
                    self.ser_status.configure(text=self.T("ser_nc"),
                                              text_color=ERR_COLOR)
                    self.ser_status2.configure(text="Serial: —",
                                               text_color=IDLE_COLOR)
                    self.log(payload)
                elif kind == "watch_try":
                    alive = self.conn_thread is not None and \
                        self.conn_thread.is_alive()
                    if not alive and not self.running \
                            and not self._manual_disconnect:
                        self.log(self.T("log_watch", p=payload))
                        self.serial_connect(payload, quiet=True)
        except queue.Empty:
            pass
        self.after(50, self.poll_rx)

    def flash(self, sid):
