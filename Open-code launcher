def slot_title(sid, lang):
    btn_names = BTN_NAMES_L.get(lang, BTN_NAMES_L["ru"])
    kind_names = KIND_NAMES_L.get(lang, KIND_NAMES_L["ru"])
    combo_names = COMBO_NAMES_L.get(lang, COMBO_NAMES_L["ru"])
    for bid, bidx in BUTTONS:
        for kind, kidx in KINDS:
            if sid == f"{bid}{kind}":
                return f"{btn_names[bidx]} — {kind_names[kidx]}"
    if sid in COMBOS:
        return f"{combo_names[COMBOS.index(sid)]}"
    return sid

