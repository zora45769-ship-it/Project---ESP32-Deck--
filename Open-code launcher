    def _fill_app_path(self):
        if "path_entry" not in self.ed:
            return
        preset = APP_PRESETS.get(self.ed["app_cb"].get())
        if preset and preset.get("path"):
            self.ed["path_entry"].delete(0, "end")
            self.ed["path_entry"].insert(0, preset["path"])
            self.ed["args_entry"].delete(0, "end")
            self.ed["args_entry"].insert(0, preset.get("args", ""))

    def on_app_preset_change(self):
        self._fill_app_path()
        self.commit_editor()

    def on_type_change(self):
        if not self.selected or not self.ed:
            return
        self.cfg["slots"][self.selected]["type"] = self.ed["type_var"].get()
        self.render_editor_body()
        self.commit_editor()

    def on_action_change(self):
        code = self.obs_code(self.ed["action_cb"].get())
        self.ed["param_cb"].configure(values=self.param_values(code))
        if code not in ("scene", "mute_src"):
            self.ed["param_cb"].set("")
        self.commit_editor()

    def collect_editor(self):
        t = self.ed["type_var"].get()
        c = {"type": t,
             "name": self.ed["name_entry"].get().strip()
             if "name_entry" in self.ed else ""}
        if t == "keys":
            if "mod_vars" in self.ed and "key_cb" in self.ed:
                c["mods"] = [m for m in MODS if self.ed["mod_vars"][m].get()]
                c["key"] = self.ed["key_cb"].get()
        elif t == "media":
            if "media_cb" in self.ed:
                c["media"] = self.ed["media_cb"].get()
        elif t == "obs":
            if "action_cb" in self.ed and "param_cb" in self.ed:
                c["obs_action"] = self.obs_code(self.ed["action_cb"].get())
                c["obs_param"] = self.ed["param_cb"].get()
        elif t == "macro":
            if "macro_box" in self.ed:
                c["steps"] = self.ed["macro_box"].get("1.0", "end").strip()
        elif t == "cmd":
            if "cmd_entry" in self.ed:
                c["cmd"] = self.ed["cmd_entry"].get().strip()
        elif t == "text":
            if "txt_entry" in self.ed:
                c["txt"] = self.ed["txt_entry"].get()
        elif t == "app":
            if "app_cb" in self.ed:
                preset = self.ed["app_cb"].get()
                c["preset"] = (CUSTOM_APP_CODE
                               if preset == self.custom_label() else preset)
                c["mode"] = self.app_code(self.ed["mode_cb"].get())
                c["path"] = self.ed["path_entry"].get().strip()
                c["args"] = self.ed["args_entry"].get().strip()
        elif t == "http":
            if "url_entry" in self.ed:
                c["method"] = self.ed["http_m_cb"].get()
                c["url"] = self.ed["url_entry"].get().strip()
                c["body"] = self.ed["body_entry"].get().strip()
        elif t == "vol":
            if "vol_cb" in self.ed:
                c["mode"] = self.vol_code(self.ed["vol_cb"].get())
        return c

    def commit_editor(self, save=True):
        if not self.selected or not self.ed:
            return
        try:
            self.cfg["slots"][self.selected] = self.collect_editor()
        except Exception:
            return
        self.update_summary_label()
        self.render_slot_list()
        if self.selected in self.list_buttons:
            self.list_buttons[self.selected].configure(fg_color=SEL_BG,
                                                       text_color="#ffffff")
        if save:
            self.save_config()

    def commit_bt_mode(self):
        self.cfg["bt_mode"] = self.bt_mode.get()
        self.save_config()
        if self.selected and self.cfg["slots"][self.selected].get(
                "type") == "obs":
            self.render_editor_body()

    def commit_auto_conn(self):
        self.cfg["auto_connect"] = self.auto_conn_var.get()
        self.save_config()

    def slot_summary(self, c):
        t = c.get("type", "none")
        e = self.T("empty")
        if t == "keys":
            return "+".join(c.get("mods", []) + [c.get("key", "")])
        if t == "media":
            return c.get("media", "")
        if t == "obs":
            s = self.T("p_obs") + self.obs_label(c.get("obs_action", "scene"))
            if c.get("obs_param"):
                s += " — " + c["obs_param"]
            return s
        if t == "macro":
            s = c.get("steps", "")
            return (self.T("p_macro") + s[:46] + "…") if len(s) > 46 else \
                   (self.T("p_macro") + s if s else self.T("p_macro").strip() + e)
        if t == "cmd":
            s = c.get("cmd", "")
            return (self.T("p_cmd") + s[:40] + "…") if len(s) > 40 else \
                   (self.T("p_cmd") + s if s else self.T("p_cmd").strip() + e)
        if t == "text":
            s = c.get("txt", "")
            return (self.T("p_text") + s[:40] + "…") if len(s) > 40 else \
                   (self.T("p_text") + s if s else self.T("p_text").strip() + e)
        if t == "app":
            preset = c.get("preset")
            if preset == CUSTOM_APP_CODE:
                preset = self.custom_label()
            return (self.T("p_app") + (preset or c.get("path") or "—")
                    + " · " + self.app_label(c.get("mode", "toggle")))
        if t == "http":
            u = c.get("url", "")
            return (self.T("p_http") + u[:40] + "…") if len(u) > 40 else \
                   (self.T("p_http") + u if u else self.T("p_http").strip() + e)
        if t == "vol":
            return self.T("p_vol") + self.vol_label(c.get("mode", "up"))
        return self.T("unassigned")

    def update_summary_label(self):
        if "summary" in self.ed and self.selected:
            c = self.cfg["slots"][self.selected]
            self.ed["summary"].configure(
                text=self.slot_summary(c),
                text_color=TYPE_COLORS.get(c.get("type", "none"), IDLE_COLOR))

