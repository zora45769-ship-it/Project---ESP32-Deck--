            return
        self.clip_slot = deepcopy(self.cfg["slots"][self.selected])
        self.paste_btn.configure(state="normal")
        self.log(self.T("copied", s=slot_title(self.selected, self.lang)))

    def slot_paste(self):
        if not self.selected or not self.clip_slot:
            return
        self.cfg["slots"][self.selected] = deepcopy(self.clip_slot)
        self.save_config()
        self.render_editor()
        self.render_slot_list()
        if self.selected in self.list_buttons:
            self.list_buttons[self.selected].configure(fg_color=SEL_BG,
                                                       text_color="#ffffff")
        self.log(self.T("pasted", s=slot_title(self.selected, self.lang)))

    # ---------------- исполнение действий ----------------
    @staticmethod
    def py_key(name):
        if name in PYNPUT_MAP:
            return PYNPUT_MAP[name]
        if len(name) == 1:
            return name.lower()
        return None

    def run_macro_steps(self, steps):
        if not HAS_PYNPUT:
            self.after(0, lambda: self.log(self.T("no_pynput")))
            return
        kb = _KbController()
        for kind, val in steps:
            if kind == "wait":
                time.sleep(val / 1000.0)
                continue
            keys = [k for k in (self.py_key(n) for n in val) if k is not None]
            if not keys:
                continue
            try:
                for k in keys:
                    kb.press(k)
                time.sleep(0.012)
                for k in reversed(keys):
                    kb.release(k)
            except Exception as ex:
                err = str(ex)
                self.after(0, lambda: self.log(self.T("macro_err", e=err)))
                return

    def execute_macro(self, spec):
        steps, errors = parse_macro(spec)
        if errors:
            e = ", ".join(errors[:3])
            self.after(0, lambda: self.log(self.T("macro_bad", e=e)))
        if not steps:
            return
        self.run_macro_steps(steps)

    def execute_text(self, txt):
        if not txt:
            return
        if not HAS_PYNPUT:
            self.after(0, lambda: self.log(self.T("no_pynput")))
            return

        def put_clip():
            try:
                self.clipboard_clear()
                self.clipboard_append(txt)
            except Exception as ex:
                err = str(ex)
                self.after(0, lambda: self.log(self.T("clip_err", e=err)))
                return

            def paste():
                time.sleep(0.05)
                try:
                    kb = _KbController()
                    kb.press(_PKey.ctrl)
                    kb.press("v")
                    time.sleep(0.012)
                    kb.release("v")
                    kb.release(_PKey.ctrl)
                except Exception as ex:
                    err = str(ex)
                    self.after(0, lambda: self.log(self.T("paste_err",
                                                          e=err)))
            threading.Thread(target=paste, daemon=True).start()

        self.after(0, put_clip)

    def execute_cmd(self, cmd):
        if not cmd:
            return
        try:
            subprocess.Popen(cmd, shell=True)
            self.after(0, lambda: self.log(self.T("cmd_ok", c=cmd[:60])))
        except Exception as ex:
            err = str(ex)
            self.after(0, lambda: self.log(self.T("cmd_err", e=err)))

    def execute_app(self, c):
        preset = APP_PRESETS.get(c.get("preset", ""))
        procs = preset["proc"] if preset else \
            [os.path.basename(c.get("path", "")).lower()]
        mode = c.get("mode", "toggle")
        path = c.get("path", "").strip()
        args = c.get("args", "").strip()

        if mode == "close":
            n = kill_procs(procs)
            if n:
                self.after(0, lambda: self.log(self.T("closed_n", n=n)))
            else:
                self.after(0, lambda: self.log(self.T("not_found")))
            return

        running = find_proc(procs)
        if mode == "focus" or (mode == "toggle" and running):
            if running and self._focus_window(c, preset, running):
                self.after(0, lambda: self.log(self.T("focus_ok")))
                return
            if running:
                self.after(0, lambda: self.log(self.T("focus_retry")))
        if not path:
            self.after(0, lambda: self.log(self.T("path_missing")))
            return
        try:
            subprocess.Popen(f'"{path}" {args}'.strip(), shell=True)
            self.after(0, lambda: self.log(self.T("run_ok", p=path)))
        except Exception as ex:
            err = str(ex)
            self.after(0, lambda: self.log(self.T("run_err", e=err)))

    def _focus_window(self, c, preset, proc):
        if not HAS_GW:
            self.after(0, lambda: self.log(self.T("gw_missing")))
            return False
        kw = (preset or {}).get("win") or \
            os.path.splitext(os.path.basename(c.get("path", "")))[0]
        try:
            wins = [w for w in gw.getWindowsWithTitle(kw) if w.title]
            if not wins:
                return False
            wins[0].activate()
            return True
        except Exception as ex:
            err = str(ex)
            self.after(0, lambda: self.log(self.T("focus_err", e=err)))
            return False

    def execute_http(self, c):
        url = c.get("url", "").strip()
        method = c.get("method", "GET")
        if not url:
            return
        try:
            data = None
            headers = {"User-Agent": "StreamDeckLauncher/9"}
            if method == "POST":
                body = c.get("body", "").strip()
                if body:
                    data = body.encode("utf-8")
                    headers["Content-Type"] = "application/json"
            req = urllib.request.Request(url, data=data, method=method,
                                         headers=headers)
            with urllib.request.urlopen(req, timeout=6) as resp:
                code = resp.getcode()
            self.after(0, lambda: self.log(self.T("http_ok", m=method,
                                                  c=code)))
        except urllib.error.HTTPError as ex:
            code = ex.code
            self.after(0, lambda: self.log(self.T("http_code", c=code)))
        except Exception as ex:
            err = str(ex)
            self.after(0, lambda: self.log(self.T("http_err", e=err)))

    def execute_vol(self, c):
        result = sys_volume_step(c.get("mode", "up"))
        self.after(0, lambda: self.log(self.T("vol_log", r=result)))

