def parse_macro(text):
    steps, errors = [], []
    for raw in (t.strip() for t in text.replace("\n", " | ").split("|")):
        if not raw:
            continue
        low = raw.lower()
        if low.startswith("wait"):
            arg = raw[4:].strip()
            for suf in ("ms", "мс"):
                if arg.lower().endswith(suf):
                    arg = arg[:-len(suf)].strip()
                    break
            try:
                steps.append(("wait", max(10, int(arg))))
            except ValueError:
                errors.append(raw)
            continue
        if low.endswith("ms") and low[:-2].strip().isdigit():
            steps.append(("wait", max(10, int(low[:-2].strip()))))
            continue
        names = [p.strip().upper() for p in raw.split("+") if p.strip()]
        if names:
            steps.append(("combo", names))
        else:
            errors.append(raw)
    return steps, errors


def find_proc(procs):
    if not HAS_PSUTIL:
        return None
    procs = [p.lower() for p in procs if p]
    try:
        for p in psutil.process_iter(["name"]):
            n = (p.info.get("name") or "").lower()
            if any(n == q or n.startswith(q) for q in procs):
                return p
    except Exception:
        pass
    return None


def kill_procs(procs):
    if not HAS_PSUTIL:
        return 0
    procs = [p.lower() for p in procs if p]
    killed = 0
    try:
        for p in psutil.process_iter(["name"]):
            n = (p.info.get("name") or "").lower()
            if any(n == q or n.startswith(q) for q in procs):
                p.terminate()
                killed += 1
    except Exception:
        pass
    return killed


def sys_volume_step(code):
    """Системная громкость. pycaw — плавно; иначе медиа-клавиши."""
    if HAS_PYCAW:
        try:
            dev = AudioUtilities.GetSpeakers()
            iface = dev.Activate(IAudioEndpointVolume._iid_, CLSCTX_ALL, None)
            vol = cast(iface, POINTER(IAudioEndpointVolume))
            if code == "mute":
                vol.SetMute(not bool(vol.GetMute()), None)
                return "mute"
            cur = vol.GetMasterVolumeLevelScalar()
            step = 0.05 if code == "up" else -0.05
            new = max(0.0, min(1.0, cur + step))
            vol.SetMasterVolumeLevelScalar(new, None)
            return f"{int(round(new * 100))}%"
        except Exception:
            pass
    if HAS_PYNPUT:
        kb = _KbController()
        key = {"up": _PKey.media_volume_up,
               "down": _PKey.media_volume_down,
               "mute": _PKey.media_volume_mute}.get(code)
        if key is not None:
            kb.press(key)
            kb.release(key)
            return code
    return "no pycaw / no pynput"


