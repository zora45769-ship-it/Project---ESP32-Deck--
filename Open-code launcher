            pass
        for sid in ALL_SLOTS:
            box = cfg["slots"].setdefault(
                sid, deepcopy(DEFAULT_SLOTS.get(sid, {"type": "none"})))
            # нормализация старых русских значений во внутренние коды
            if box.get("obs_action") in LEG_OBS:
                box["obs_action"] = LEG_OBS[box["obs_action"]]
