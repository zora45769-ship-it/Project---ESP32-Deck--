                box["mode"] = LEG_APP[box["mode"]]
            if box.get("type") == "vol" and box.get("mode") in LEG_VOL:
                box["mode"] = LEG_VOL[box["mode"]]
            if box.get("preset") in LEG_PRESET:
                box["preset"] = LEG_PRESET[box["preset"]]
            # профили тоже
        for prof in cfg.get("profiles", {}).values():
            for box in prof.get("slots", {}).values():
                if box.get("obs_action") in LEG_OBS:
                    box["obs_action"] = LEG_OBS[box["obs_action"]]
                if box.get("type") == "app" and box.get("mode") in LEG_APP:
                    box["mode"] = LEG_APP[box["mode"]]
                if box.get("type") == "vol" and box.get("mode") in LEG_VOL:
                    box["mode"] = LEG_VOL[box["mode"]]
                if box.get("preset") in LEG_PRESET:
                    box["preset"] = LEG_PRESET[box["preset"]]
        return cfg

