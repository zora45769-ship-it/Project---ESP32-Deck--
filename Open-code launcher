        self.save_config()
        for w in self.winfo_children():
            w.destroy()
        self.build_ui()
        self.render_slot_list()
        self.select_slot(self.selected or ALL_SLOTS[0])
        self.log(f"Language: {self.lang.upper()}")

    # ---------------- список слотов ----------------
    def slot_caption(self, sid):
        c = self.cfg["slots"][sid]
        name = c.get("name") or slot_title(sid, self.lang)
        return f"{name}   ·   {self.slot_summary(c)}"

    def render_slot_list(self):
        query = ""
        if hasattr(self, "search_entry"):
            query = self.search_entry.get().lower().strip()
        for child in self.slot_list.winfo_children():
            child.destroy()
        self.list_buttons = {}
        for sid in ALL_SLOTS:
            title = (slot_title(sid, self.lang) + " " +
                     (self.cfg["slots"][sid].get("name") or "")).lower()
            caption = self.slot_caption(sid)
            if query and query not in title and query not in caption.lower():
                continue
            c = self.cfg["slots"][sid]
            sel = (sid == self.selected)
            btn = ctk.CTkButton(
                self.slot_list, text=caption, anchor="w", height=32,
                font=self.f_small,
                fg_color=SEL_BG if sel else "transparent",
                hover_color=HOVER_COLOR,
                text_color="#ffffff" if sel else
                TYPE_COLORS.get(c.get("type", "none"), IDLE_COLOR),
                command=lambda s=sid: self.select_slot(s))
            btn.pack(fill="x", pady=1)
            self.list_buttons[sid] = btn

    def select_slot(self, sid):
        if self.selected and self.ed:
            try:
                self.commit_editor(save=False)
            except Exception:
                pass
        prev = self.selected
        if prev in self.list_buttons:
            self.list_buttons[prev].configure(
                fg_color="transparent",
                text_color=TYPE_COLORS.get(
                    self.cfg["slots"][prev].get("type", "none"), IDLE_COLOR))
        self.selected = sid
        if sid in self.list_buttons:
            self.list_buttons[sid].configure(fg_color=SEL_BG,
                                             text_color="#ffffff")
        self.render_editor()

