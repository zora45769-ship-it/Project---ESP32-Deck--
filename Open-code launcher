    def on_trigger(self, sid):
        self.flash(sid)
        stats = self.cfg.setdefault("stats", {})
        stats[sid] = stats.get(sid, 0) + 1
        self.save_config()
        if self.test_mode.get():
            self.log(self.T("test_log", s=slot_title(sid, self.lang)))
            return
        c = self.cfg["slots"].get(sid, {})
        t = c.get("type")
        if t == "obs" and not self.bt_mode.get() and self.obs_client:
            self.obs_execute(c.get("obs_action", "scene"),
                             c.get("obs_param", ""))
        elif t in ("macro", "cmd", "text", "app", "http", "vol"):
            threading.Thread(target=self.execute_action, args=(deepcopy(c),),
                             daemon=True).start()
        # keys/media исполняет сама плата

    # ---------------- запись конфига ----------------
    def push_config(self):
        if not self.ser or not self.running:
            messagebox.showwarning(self.T("err_serial"),
                                   self.T("warn_conn_first"))
            return
        if self.busy:
            return
        if self.selected and self.ed:
            self.commit_editor()
        try:
            port = int(self.obs_port.get() or 4455)
        except ValueError:
            port = 4455
        self.cfg["obs"] = {"host": self.obs_host.get(),
                           "port": port,
                           "password": self.obs_pass.get()}
        self.cfg["bt_mode"] = self.bt_mode.get()
        self.busy = True
        self.push_btn.configure(state="disabled", text=self.T("pushing"))
        threading.Thread(target=self._push_worker, daemon=True).start()

    def _push_worker(self):
        try:
            specs, hints, obs_n = {}, [], 0
            for sid in ALL_SLOTS:
                c = self.cfg["slots"][sid]
                t = c["type"]
                if t == "keys":
                    specs[sid] = "KEYS:" + "+".join(
                        c.get("mods", []) + [c["key"]])
                elif t == "media":
                    specs[sid] = "MEDIA:" + c.get("media", "PLAY")
                elif t == "obs":
                    if self.bt_mode.get():
                        obs_n += 1
                        digit = str(obs_n) if obs_n <= 9 else "0"
                        specs[sid] = f"KEYS:CTRL+ALT+SHIFT+{digit}"
                        hints.append(
                            f"{slot_title(sid, self.lang)}: "
                            f"CTRL+ALT+SHIFT+{digit}")
                    else:
                        specs[sid] = "OBS"
                else:
                    specs[sid] = "NONE"

            items = list(specs.items())
            for i in range(0, len(items), BLOCK_SIZE):
                block = items[i:i + BLOCK_SIZE]
                for sid, spec in block:
                    try:
                        with self.io_lock:
                            self.ser.write(
                                f"SET {sid} {spec}\n".encode("utf-8"))
                    except Exception as ex:
                        e = str(ex)
                        self.after(0, lambda: messagebox.showerror(
                            self.T("err_esp32"),
                            self.T("port_closed", e=e)))
                        return
                for sid, _ in block:
                    deadline = time.time() + 1.5
                    ok = False
                    while time.time() < deadline:
                        try:
                            ln = self.reply_q.get(timeout=0.05)
                        except queue.Empty:
                            continue
                        if ln.startswith("OK "):
                            ok = True
                            break
                        if ln.startswith("ERR"):
                            e = ln
                            self.after(0, lambda: messagebox.showerror(
                                self.T("err_esp32"),
                                self.T("slot_err", s=sid, e=e)))
                            return
                    if not ok:
                        self.after(0, lambda: messagebox.showerror(
                            self.T("err_esp32"),
                            self.T("slot_ack", s=sid)))
                        return

            resp = self.request("APPLY", stops=("OK APPLY",))
            if not (resp and any(r.startswith("OK APPLY") for r in resp)):
                self.after(0, lambda: messagebox.showerror(
                    self.T("err_esp32"), self.T("apply_err")))
                return

            self.save_config()
            self.after(0, lambda: self._push_done(hints))
        except Exception as ex:
            err = str(ex)
            self.after(0, lambda: self.log(f"[push] {err}"))
        finally:
            self.after(0, self._push_unlock)

    def _push_unlock(self):
        self.busy = False
        self.push_btn.configure(state="normal", text=self.T("push"))

    def _push_done(self, hints):
        self.log(self.T("push_ok"))
        if hints:
            messagebox.showinfo(
                self.T("done"),
                self.T("push_msg_hdr") + "\n".join(hints) +
                self.T("push_msg_tip"))
        else:
            messagebox.showinfo(self.T("done"), self.T("push_done"))

    def read_from_device(self):
        if not self.ser or not self.running:
            messagebox.showwarning(self.T("err_serial"),
                                   self.T("warn_conn_first"))
            return
        resp = self.request("LIST", stops=("OK LIST",), timeout=3.0)
        if not resp:
            self.log(self.T("list_fail"))
            return
        self.log(self.T("list_hdr"))
        for ln in resp:
            if ln.startswith("SLT "):
                self.log(ln[4:])

    def reset_device(self):
        if not self.ser or not self.running:
            messagebox.showwarning(self.T("err_serial"),
                                   self.T("warn_conn_first"))
            return
        if messagebox.askyesno(self.T("reset_t"), self.T("reset_q")):
            self.request("RESET", stops=("OK RESET",))
            self.log(self.T("reset_ok"))
            messagebox.showinfo(self.T("done"), self.T("reset_ok"))

    # ---------------- OBS ----------------
    def obs_connect(self):
        if obs is None:
            messagebox.showerror(self.T("obs_t"), self.T("obs_lib"))
            return
        try:
            port = int(self.obs_port.get() or 4455)
        except ValueError:
            port = 4455
        try:
            cl = obs.ReqClient(host=self.obs_host.get().strip() or "localhost",
                               port=port,
                               password=self.obs_pass.get(), timeout=3)
            scenes = cl.get_scene_list()
            inputs = cl.get_input_list()
            self.obs_client = cl
            self.obs_scenes = [s.scene_name for s in scenes.scenes]
            self.obs_inputs = [i.input_name for i in inputs.inputs]
            self.obs_status.configure(text=self.T("obs_ok"),
                                      text_color=OK_COLOR)
            self.log(self.T("obs_log", s=len(self.obs_scenes),
                            i=len(self.obs_inputs)))
            if self.ed.get("action_cb") is not None:
                code = self.obs_code(self.ed["action_cb"].get())
                self.ed["param_cb"].configure(values=self.param_values(code))
        except Exception as ex:
            messagebox.showerror(self.T("obs_t"),
                                 self.T("obs_fail", e=ex))

    def obs_execute(self, action_code, param):
        cl = self.obs_client

        def run():
            with self.obs_lock:
                try:
                    if action_code == "scene" and param:
                        cl.set_current_program_scene(param)
                    elif action_code == "stream":
                        if cl.get_stream_status().output_active:
                            cl.stop_stream()
                        else:
                            cl.start_stream()
                    elif action_code == "record":
                        cl.toggle_record()
                    elif action_code == "mute_src" and param:
                        cl.toggle_input_mute(param)
                    elif action_code == "transition":
                        cl.trigger_studio_mode_transition()
                    elif action_code == "replay":
                        cl.save_replay_buffer()
                except Exception as ex:
                    err = str(ex)
                    self.after(0, lambda: self.log(self.T("obs_err_log",
                                                          e=err)))

        threading.Thread(target=run, daemon=True).start()

    def on_close(self):
        if self.selected and self.ed:
            try:
                self.commit_editor()
            except Exception:
                pass
        self.save_config()
        self.running = False
        self._watcher_stop.set()
        try:
            self._finalize_disconnect()
        except Exception:
            pass
        if self.obs_client:
            try:
                self.obs_client.disconnect()
            except Exception:
                pass
        self.destroy()


if __name__ == "__main__":
    app = StreamDeckApp()
    app.protocol("WM_DELETE_WINDOW", app.on_close)
    app.mainloop()
